# Copy to .env.local and fill in. Never commit .env.local.

# Where the Go API lives. The BFF proxy and server components call this;
# the browser only ever talks to the Next.js origin.
BACKEND_URL=http://localhost:8080

# "dev" (seeded personas, local only) or "entra" (Microsoft Entra External ID).
# A production build refuses to start in dev mode.
AUTH_MODE=dev

# Signs the session cookie. Generate one: openssl rand -base64 32
AUTH_SECRET=

# --- AUTH_MODE=entra only. See docs/entra-setup.md. ---
# AUTH_MICROSOFT_ENTRA_ID_ID=<frontend app registration client id>
# AUTH_MICROSOFT_ENTRA_ID_SECRET=<frontend app registration client secret>
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://<tenant>.ciamlogin.com/<tenantId>/v2.0
# Without this scope Entra issues a Microsoft Graph token, which looks valid
# and fails the backend's audience check.
# BACKEND_API_SCOPE=api://<backend client id>/access_as_user
